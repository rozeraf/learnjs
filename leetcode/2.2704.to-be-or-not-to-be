type ToBeOrNotToBe = {
  toBe: (val: any) => boolean;
  notToBe: (val: any) => boolean;
};

function expect(val: any): ToBeOrNotToBe {
  return {
    toBe(otherVal) {
      if (otherVal === val) {
        return true;
      }
      throw new Error('Not Equal');
    },
    notToBe(otherVal) {
      if (otherVal !== val) {
        return true;
      }
      throw new Error('Equal');
    },
  };
}
